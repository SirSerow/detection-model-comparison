# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.github/

# Virtual environments
.venv/
venv/
env/

# Editors / OS
.idea/
.vscode/
*.swp
Thumbs.db
Desktop.ini

# Local env
.env
.env.*

# Optional upstream detector source trees (installed/cloned per target device)
third_party/

# Datasets — do not commit COCO images or annotation payloads
datasets/coco/val2017/
datasets/coco/annotations/*.json
datasets/coco/*.zip

# Downloaded model checkpoints
weights/**/*.pt
weights/**/*.pth
weights/**/*.pdparams

# Export / engine artifacts
*.engine
*.plan
*.trt
*.onnx
*.onnx.data
*.param
*.bin
*.ncnn.bin
*.ncnn.param

# Benchmark result payloads (keep directory placeholders)
results/raw/**
!results/raw/.gitkeep
results/processed/**
!results/processed/.gitkeep
results/summaries/**
!results/summaries/.gitkeep
results/figures/**
!results/figures/.gitkeep
